# App Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

## Database
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_generator?pgbouncer=true
DIRECT_URL=postgresql://user:pass@localhost:5432/ai_generator
DATABASE_SSL=false

# JWT
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-from-console
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# S3/R2 (Cloudflare R2 é compatível com S3)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=ai-generations
S3_PUBLIC_URL=https://cdn.theaimodelab.com.br/storage/v1/object/public/ai-generations # CDN URL para servir arquivos

# The AI Model Lab Provider (servico externo que faz todas as geracoes de IA)
THEAIMODELAB_PROVIDER_URL=http://localhost:3001
THEAIMODELAB_API_KEY=

# Pagamentos
STRIPE_SECRET_KEY=           # sk_test_... (dev) ou sk_live_... (prod)
STRIPE_WEBHOOK_SECRET=       # whsec_... do Stripe Dashboard
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel

# Stripe Price IDs (v5 pricing — ,90)
STRIPE_PRICE_PLAN_STARTER=   # live: price_1TFgcaBFQnG9Nke5RUqrwaMR (R$39,90/mês)
STRIPE_PRICE_PLAN_CREATOR=   # live: price_1TFgcbBFQnG9Nke5b4QqLHwU (R$89,90/mês)
STRIPE_PRICE_PLAN_PRO=       # live: price_1TFgccBFQnG9Nke5c5GC5onO (R$179,90/mês)
STRIPE_PRICE_PLAN_STUDIO=    # live: price_1TFgcdBFQnG9Nke5iKG0gMWe (R$369,90/mês)
STRIPE_PRICE_BOOST_P=        # live: price_1TFgceBFQnG9Nke5CvuZNGEV (R$14,90)
STRIPE_PRICE_BOOST_M=        # live: price_1TFgcfBFQnG9Nke5RBKX91I4 (R$26,90)
STRIPE_PRICE_BOOST_G=        # live: price_1TFgcgBFQnG9Nke5IhiNaGPw (R$36,90)

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ASAAS (PIX para boost — cobrança única; quando ligar PIX Automático para
# assinaturas, reusar a mesma API key)
# Sandbox: https://api-sandbox.asaas.com  |  Produção: https://api.asaas.com
ASAAS_API_KEY=               # $aact_... (gerado no painel do ASAAS)
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_WEBHOOK_SECRET=        # token livre — configurar igual no webhook do painel ASAAS

# Hotmart (webhook de compra de curso → pending grant de free generations)
HOTMART_HOTTOK=             # token configurado no painel da Hotmart

# Greenn (webhook de compra de curso → pending grant de free generations)
GREENN_WEBHOOK_TOKEN=       # token compartilhado: enviado via ?token= ou header x-greenn-token

# Cartpanda (webhook de compra → pending grant de free generations)
CARTPANDA_WEBHOOK_TOKEN=    # token compartilhado: enviado via ?token= ou header x-cartpanda-token

# Perfect Pay (webhook POST /api/v1/webhooks/perfectpay) — MONETIZAÇÃO POR ASSINATURA MENSAL
#  - Assinatura mensal: plan.code casado com plans.perfectpay_plan_code → cria/renova
#    a assinatura recorrente (a PerfectPay dispara o webhook a cada cobrança mensal).
#  - Cancelamento/reembolso/chargeback: revoga a assinatura (acesso até fim do período
#    no cancelamento normal; imediato em reembolso/chargeback).
#  - Demais produtos (curso): libera pending grant de free generations por email.
PERFECTPAY_WEBHOOK_TOKEN=   # token compartilhado: enviado via payload.token, ?token= ou header x-perfectpay-token (aceita lista separada por vírgula)
PERFECTPAY_WEBHOOK_EXTRA_TOKENS=  # tokens adicionais aceitos (contas de afiliados), separados por vírgula: tok1,tok2,tok3
# Códigos de plano (default = último segmento do link de checkout; preencher só se o
# code do postback for diferente). Casam com plans.perfectpay_plan_code.
PERFECTPAY_PLAN_CREATOR=    # ex: PPU38CQDTOF
PERFECTPAY_PLAN_PRO=        # ex: PPU38CQDTOD
PERFECTPAY_PLAN_ADVANCED=   # ex: PPU38CQDTOA
PERFECTPAY_PLAN_STUDIO=     # ex: PPU38CQDTOH
PERFECTPAY_PLAN_AGENCY=     # code do POSTBACK do plano Agency (US$199,90) — sem isso o webhook não casa a venda

# Links de checkout da assinatura mensal recorrente (PerfectPay) — o front redireciona.
CHECKOUT_URL_CREATOR=       # https://checkout.centerpag.com/pay/PPU38CQDTOF  (R$89,90/mês)
CHECKOUT_URL_PRO=           # https://checkout.centerpag.com/pay/PPU38CQDTOD  (R$179,90/mês)
CHECKOUT_URL_ADVANCED=      # https://checkout.centerpag.com/pay/PPU38CQDTOA  (R$249,90/mês)
CHECKOUT_URL_STUDIO=        # https://checkout.centerpag.com/pay/PPU38CQDTOH  (R$369,90/mês)
CHECKOUT_URL_AGENCY=        # link recorrente do Agency (US$199,90/mês) — vazio = plano oculto na vitrine USD
CAKTO_OFFER_AGENCY=         # short-code da oferta Agency na Cakto (R$899,90/mês) — vazio = oculto na vitrine BRL
# Planos ANUAIS (pro/advanced/studio/agency + "-anual"): o normal é cadastrar os links em /admin/planos.
# Estas envs só valem pro seed: CHECKOUT_URL_<PLANO>_ANUAL, PERFECTPAY_PLAN_<PLANO>_ANUAL, CAKTO_OFFER_<PLANO>_ANUAL (ex.: CHECKOUT_URL_PRO_ANUAL).

# Redis (BullMQ + Pub/Sub)
REDIS_URL=redis://default:password@localhost:6379

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Firebase (Phone Auth — verificação de SMS no cadastro)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=The AI Model Lab <noreply@theaimodelab.ai>
FRONTEND_URL=http://localhost:5173

# Meta Ads tracking
META_PIXEL_ID=1327084455720433
META_ACCESS_TOKEN=              # token CAPI gerado no Events Manager (nunca commitar valor real)
META_GRAPH_API_VERSION=v23.0
META_TEST_EVENT_CODE=           # opcional: usar em teste no Events Manager

# Watermark
WATERMARK_IMAGE_PATH=assets/watermark.png

# Replicate (legado — não mais usado; Seedream migrou para WaveSpeed)
REPLICATE_API_TOKEN=

# WaveSpeed — Seedream V5.0 Pro (imagem: sem-censura + undress) e OmniVoice (áudio)
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai

# Deepdeep (n88ed) — modelo de imagem image-to-image
DEEPDEEP_API_KEY=
DEEPDEEP_BASE_URL=https://use.n88ed.app
DEEPDEEP_POLL_INTERVAL_MS=5000

# Kling V3 Turbo (image-to-video) — usa a mesma API kie.ai do NANO_BANANA_*.
# Não precisa de chave própria; reutiliza NANO_BANANA_BASE_URL / NANO_BANANA_API_KEY.

# ComfyDeploy (WanImageToVideo — modelo de vídeo NSFW/legacy)
COMFYDEPLOY_API_KEY=
COMFYDEPLOY_DEPLOYMENT_ID=
COMFYDEPLOY_BASE_URL=https://api.comfydeploy.com

# HeyGen (clonagem de avatar — Digital Twin v3)
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_WEBHOOK_SECRET=
# {avatarId} é substituído em runtime pelo backend ao montar a URL final
HEYGEN_CONSENT_REROUTE_URL=http://localhost:3000/workspace/avatars/{avatarId}?consent=done
AVATAR_TRAINING_CREDITS_PHOTO=1250
AVATAR_TRAINING_CREDITS_DIGITAL_TWIN=2000
AVATAR_TRAINING_TIMEOUT_MIN=90

# Sequências automáticas de email (onboarding + pós-assinatura):
# liga/desliga pelo toggle em /admin/emails (tabela app_settings) — sem env var.

# Emails de lifecycle de monetização (saldo baixo / créditos esgotados / winback)
# Cron diário 14h UTC — só roda com a flag explicitamente em "true".
LIFECYCLE_EMAILS_ENABLED=false

# Denúncias de conteúdo (/api/v1/reports): quem recebe o aviso de denúncia urgente (menor, imagem íntima)
REPORTS_ALERT_EMAIL=
# Chave do hash do IP das denúncias (sem ela, o IP não é guardado). Gere um valor aleatório longo.
REPORTS_IP_SALT=
# Opcional: link do admin/cockpit em cada linha do resumo de denúncias urgentes
REPORTS_ADMIN_URL=
# Remoção confirmada (POST /api/v1/admin/takedowns/reports/:id): purga do CDN por URL na Cloudflare.
# Token com SÓ a permissão "Zone > Cache Purge" da zona do CDN da mídia, e o id (32 caracteres) dessa zona.
# Vazio = a purga fica pendente com o motivo e a varredura de 10 min tenta quando as duas existirem. Nunca commitar valor
CLOUDFLARE_PURGE_TOKEN=
CLOUDFLARE_ZONE_ID=

# Registro de acesso (Marco Civil, art. 15): login e pedido de geração, com IP, porta, user agent e horário UTC.
# Vale em qualquer modo. Sem proxy declarado, nenhum cabeçalho é lido e o IP gravado é o do socket (o do proxy, se houver),
# e a API loga um erro a cada boot até TRUSTED_PROXY_HOPS ou TRUSTED_PROXY_IPS ser definido (checklist de deploy).
# Saltos de proxy confiáveis na frente da API (0 a 10; ex.: 1 = só o rewrite da Vercel, 2 = Vercel + nginx no VPS)
TRUSTED_PROXY_HOPS=
# OU a lista dos proxies confiáveis (vírgula: loopback, linklocal, uniquelocal, IP ou CIDR). Só confie no que a porta
# da API aceita: com a porta aberta para a internet, quem chama direto forja o x-forwarded-for.
# Vale também para o IP da trilha do revisor e do admin (content_safety_access_log): sem proxy declarado, ela grava o 1º
# salto do x-forwarded-for, que quem chama o VPS direto consegue forjar
TRUSTED_PROXY_IPS=
# Cabeçalho em que o proxy da frente grava a porta de origem (nginx: proxy_set_header X-Real-Port $remote_port).
# Nunca x-forwarded-port (é a porta de destino). Vazio = x-real-port
ACCESS_LOG_PORT_HEADER=
# Meses de guarda antes do apagamento automático (mínimo e padrão 6, máximo 60); conta sob guarda legal nunca perde linha
ACCESS_LOG_RETENTION_MONTHS=

# Exclusão LGPD (POST /api/v1/admin/users/:id/erase): tempo máximo da limpeza do bucket antes de seguir em segundo plano (ms, até 120000)
ACCOUNT_ERASURE_SYNC_BUDGET_MS=20000

# Mídia (uploads): cache do bucket público, em segundos (padrão 86400 = 1 dia, sem immutable: apagar + purgar tira do ar)
MEDIA_CACHE_MAX_AGE=86400
# Bucket PRIVADO das mídias enviadas pela cliente (inputs/<id da geração>/), no mesmo endpoint S3 do bucket público.
# Vazio = entradas seguem no bucket público (a API avisa uma vez no boot). Nunca o mesmo nome do S3_BUCKET_NAME.
S3_INPUT_PRIVATE_BUCKET=
# Validade da URL assinada de leitura que o provedor recebe para cada entrada privada (segundos, 3600 a 604800).
# A API reassina a cada tentativa: o valor cobre uma tentativa (vídeo até 45 min + busca assíncrona do provedor)
SAFETY_INPUT_URL_TTL=7200

# Segurança de imagem e texto (checagem da foto/vídeo antes do provedor, do resultado antes do link e do texto).
# Tudo desligado por padrão: off = comportamento atual. Valor inválido vira o padrão e gera aviso no boot.
# off | shadow | enforce. shadow registra; com IMAGE_SAFETY_ENFORCE_STRONG, as regras fortes já agem
# Recusa do provedor em pedido com foto/vídeo/áudio da cliente: com off, o desvio segue como antes (sem censura só com
# o atestado de imagem; menor sempre encerra); com shadow ou enforce, só desvia com a checagem da mídia limpa
IMAGE_SAFETY_MODE=off
TEXT_CLASSIFIER_MODE=off
# Regras fortes (criança evidente, provável menor em pedido sexual, resultado com menor) agem já na sombra (padrão true)
IMAGE_SAFETY_ENFORCE_STRONG=true
# Limites das regras: vazio = valor da versão das regras (entre parênteses)
SAFETY_AGE_GRAY_MAX=              # fim da zona de dúvida, ponto médio de idade (23)
SAFETY_OUTPUT_REVIEW_AGE_MAX=     # resultado com nudez e ponto médio abaixo disto vai para revisão (21)
SAFETY_NUDITY_MIN=                # score de nudez que conta (60)
SAFETY_CHILD_LABEL_MIN=           # confiança do rótulo de criança que conta (85)
SAFETY_PHASH_MAX_DISTANCE=        # distância de Hamming para "mesma foto" (8)
SAFETY_VIDEO_MAX_FRAMES=          # teto de quadros checados por vídeo (12)
SAFETY_VIDEO_EVERY_SECONDS=       # 1 quadro a cada N segundos (2)
SAFETY_VIDEO_SCENE_THRESHOLD=     # corte de cena do ffmpeg (0.3)
# Foto com criança: true = barra em qualquer pedido; false = só no lado adulto (sem censura, despir, pedido sexual)
SAFETY_CHILD_BLOCK_ALL_SURFACES=true
# Conta AWS de segurança (Rekognition e Bedrock). Principal em São Paulo; reserva "none" desliga a reserva
AWS_REGION_SAFETY=sa-east-1
AWS_REGION_SAFETY_FALLBACK=us-east-1
# Credenciais próprias (opcional; vazio = cadeia padrão do SDK). Nunca commitar valor real
AWS_SAFETY_ACCESS_KEY_ID=
AWS_SAFETY_SECRET_ACCESS_KEY=
# Classificador de texto na Bedrock (vazio = regiões do Rekognition). Sem o id do modelo, o classificador fica desligado
BEDROCK_REGION=
BEDROCK_REGION_FALLBACK=
BEDROCK_SAFEGUARD_MODEL_ID=
# Caminho ABSOLUTO da política do classificador, fora da pasta da aplicação. Vazio = classificador desligado
SAFETY_POLICY_SOURCE=
# Segunda opinião do texto (só registra, nunca bloqueia). Vazio = não roda
OPENAI_MODERATION_API_KEY=
# Buckets privados: quarentena do resultado e evidência (separados e nunca o S3_BUCKET_NAME).
# Sem S3_EVIDENCE_BUCKET nem S3_INPUT_PRIVATE_BUCKET a checagem de imagem NÃO liga (a prova não teria onde ficar).
# Quarentena: regra de ciclo de vida de 7 dias ou mais (o prazo máximo de um resultado segurado é 24 h).
# Evidência (e o bucket privado de entradas, quando a evidência mora nele): SEM regra de expiração; Object Lock.
S3_QUARANTINE_BUCKET=
S3_EVIDENCE_BUCKET=
# Slugs de modelos com filtro comprovado liberados sem checagem depois de 10 min (vírgula; vazio = nenhum).
# Sem censura, Grok, Spicy, Kling e Seedance são recusados
SAFETY_TRUSTED_FILTER_MODELS=
# Ids de usuário que revisam casos de segurança (vírgula; separado do papel ADMIN). Só eles liberam evidência de imagem e
# caso confirmado, reativam conta suspensa pela segurança e, com a lista preenchida ou alguma checagem ligada, descartam
# ou liberam a evidência de denúncia de menor, crime, imagem íntima ou pessoa retratada. Ponha o id do dono (a sessão
# admin do cockpit) ANTES de preencher, senão o cockpit perde esses botões
SAFETY_REVIEWER_IDS=
# Canal de revisão citado no aviso de suspensão (LGPD, art. 20): e-mail ou endereço https.
# Vazio = o site (FRONTEND_URL em https) ou, sem ele, "fale com o suporte"
SAFETY_REVIEW_CONTACT=
# Juiz de imagem estilizada e hash de abuso conhecido (dependem de contrato; vazio = desligados)
HIVE_API_KEY=
ARACHNID_API_KEY=
